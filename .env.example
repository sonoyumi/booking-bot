# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot).
# Им приходят уведомления о новых записях и отменах, им доступна команда /today.
ADMIN_IDS=

# Часовой пояс заведения
TIMEZONE=Europe/Rome

# Рабочие часы: первый слот в WORK_START, последний заканчивается к WORK_END
WORK_START=10
WORK_END=19
SLOT_MINUTES=60

# На сколько дней вперёд можно записаться и какие дни рабочие (1 = понедельник ... 7 = воскресенье)
DAYS_AHEAD=7
WORK_DAYS=1,2,3,4,5,6

# За сколько минут до визита напомнить клиенту
REMIND_BEFORE_MINUTES=120

# Файлы (относительные пути считаются от папки проекта)
DATABASE_PATH=data/bookings.db
SERVICES_PATH=config/services.json
